# ─────────────────────────────────────────────────────────────
# Thumbnail Department — environment
# Copy to .env.local for development. Everything except the two
# NEXT_PUBLIC_* values is server-only and must never reach the browser.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (local defaults are printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Force every external API (YouTube, Claude, Leonardo) onto its development
# mock even if a key is present. Adapters also fall back to mocks
# automatically when their key is missing. Mock output is labelled in the UI.
MOCK_EXTERNAL_APIS=false

# YouTube Data API v3
YOUTUBE_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5

# Leonardo AI Production API
LEONARDO_API_KEY=
LEONARDO_MODEL_ID=
# Shared secret Leonardo sends as `Authorization: Bearer <secret>` on webhooks.
# Set the same value as the webhook API key in the Leonardo dashboard.
LEONARDO_WEBHOOK_SECRET=

# Inbound automation (Make.com, Claude Code scripts)
# Sent as `Authorization: Bearer <key>` or `x-api-key: <key>`.
AUTOMATION_API_KEY=

# Outgoing webhooks (research.complete, review.required, job.approved, …)
# Leave blank to record events without sending them.
OUTGOING_WEBHOOK_URL=
# Each request carries `x-thumbnaildept-signature: sha256=<hmac of raw body>`.
OUTGOING_WEBHOOK_SECRET=

# Cron / scheduled jobs (monthly trend refresh, later phase)
CRON_SECRET=
